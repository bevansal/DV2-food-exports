{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart: each market's share of Australian food exports in 2006 compared with 2025. Green lines grew their share, red lines shrank, grey lines changed by less than one percentage point.",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/slope_2006_2025.csv"
  },
  "encoding": {
    "x": {
      "field": "year_label",
      "type": "ordinal",
      "title": null,
      "scale": {
        "padding": 1.1
      },
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          23
        ]
      },
      "axis": null
    },
    "color": {
      "field": "direction",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Grew its share",
          "Held steady",
          "Lost share"
        ],
        "range": [
          "#3E7C4F",
          "#8A8274",
          "#B4532A"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line"
      },
      "encoding": {
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.country == 'China' || datum.country == 'Japan'",
            "value": 4.5
          },
          "value": 2.5
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 70,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Market"
          },
          {
            "field": "year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of food exports (%)",
            "format": ".1f"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Food exports (A$m)",
            "format": "$,.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2006"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 12
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#FAF6EE",
    "font": "'Source Sans 3', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5C564C",
      "titleColor": "#3A362F",
      "gridColor": "#E8E1D3",
      "domainColor": "#BDB4A4",
      "tickColor": "#BDB4A4",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#3A362F",
      "titleColor": "#3A362F",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
