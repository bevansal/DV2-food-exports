{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal waterfall chart: how each commodity group added to (or took away from) food export growth between 2014-15 and 2024-25. Bar start and end points are pre-calculated in the CSV.",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/waterfall_2015_2025.csv"
  },
  "encoding": {
    "y": {
      "field": "label",
      "type": "ordinal",
      "sort": null,
      "title": null,
      "axis": {
        "ticks": false,
        "domain": false,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "bar_start",
          "type": "quantitative",
          "title": "Food exports (A$ billion)",
          "scale": {
            "domain": [
              0,
              70000
            ]
          },
          "axis": {
            "labelExpr": "'$' + datum.value / 1000 + 'b'",
            "tickCount": 7
          }
        },
        "x2": {
          "field": "bar_end"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Total",
              "Increase",
              "Decrease"
            ],
            "range": [
              "#3A362F",
              "#5B8C6A",
              "#B4532A"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "label",
            "type": "nominal",
            "title": "Step"
          },
          {
            "field": "text_amount",
            "type": "nominal",
            "title": "Change"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "bar_end",
          "type": "quantitative"
        },
        "text": {
          "field": "text_amount",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#FAF6EE",
    "font": "'Source Sans 3', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5C564C",
      "titleColor": "#3A362F",
      "gridColor": "#E8E1D3",
      "domainColor": "#BDB4A4",
      "tickColor": "#BDB4A4",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#3A362F",
      "titleColor": "#3A362F",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
