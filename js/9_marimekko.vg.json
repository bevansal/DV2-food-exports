{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Marimekko (mosaic) chart for 2025: each row is a market and its height shows how much that market buys in total; the coloured blocks show what it buys. Block corners are pre-calculated in the CSV.",
  "width": "container",
  "height": 440,
  "data": {
    "url": "data/market_mix_2025.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FAF6EE",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "Share of what each market buys",
          "scale": {
            "domain": [
              -0.3,
              1
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "format": "%",
            "grid": false,
            "domain": false
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "reverse": true,
            "nice": false
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "commodity",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Beef",
              "Lamb, other meat & live animals",
              "Grains",
              "Canola & oilseeds",
              "Dairy",
              "Fruit, nuts & vegetables",
              "Wine & spirits",
              "Seafood, sugar & other"
            ],
            "range": [
              "#9E2A2B",
              "#D4704A",
              "#D99A1E",
              "#8F9A36",
              "#7FA6C0",
              "#3E7C4F",
              "#6E2B57",
              "#2B5E7E"
            ]
          },
          "legend": {
            "orient": "top",
            "columns": 4,
            "symbolType": "square",
            "labelLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "market",
            "type": "nominal",
            "title": "Market"
          },
          {
            "field": "commodity",
            "type": "nominal",
            "title": "Commodity"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Exports 2025 (A$m)",
            "format": "$,.0f"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of this market's purchases (%)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.show_share == 'True'"
        }
      ],
      "mark": {
        "type": "text",
        "color": "white",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative"
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative"
        },
        "text": {
          "field": "share_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.first == 'True'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#23211E"
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative"
        },
        "text": {
          "field": "market_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#FAF6EE",
    "font": "'Source Sans 3', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5C564C",
      "titleColor": "#3A362F",
      "gridColor": "#E8E1D3",
      "domainColor": "#BDB4A4",
      "tickColor": "#BDB4A4",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#3A362F",
      "titleColor": "#3A362F",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
