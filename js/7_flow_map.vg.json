{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Flow map: lines from Australia to its 15 largest food export markets in 2025. Line width and circle size show export value. Equal Earth projection rotated so the Pacific is in the centre.",
  "width": "container",
  "height": 500,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.NAME != 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#E2DCCF",
        "stroke": "white",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.NAME == 'Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#3E7C4F",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/flow_routes_2025.csv"
      },
      "mark": {
        "type": "line",
        "color": "#8C3B1F",
        "opacity": 0.55,
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "order": {
          "field": "order",
          "type": "quantitative"
        },
        "strokeWidth": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              15000
            ],
            "range": [
              0.5,
              11
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "data/flows_2025.csv"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#8C3B1F",
            "opacity": 0.9,
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "size": {
              "field": "value",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  15000
                ],
                "range": [
                  10,
                  500
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "rank",
                "type": "quantitative",
                "title": "Rank"
              },
              {
                "field": "country",
                "type": "nominal",
                "title": "Market"
              },
              {
                "field": "value",
                "type": "quantitative",
                "title": "Food exports 2025 (A$m)",
                "format": "$,.0f"
              },
              {
                "field": "share",
                "type": "quantitative",
                "title": "Share of all food exports (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.show_label == 'True' && datum.label_side == 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 9,
            "dy": -12,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#23211E"
          },
          "encoding": {
            "text": {
              "field": "country",
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.show_label == 'True' && datum.label_side == 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 9,
            "dy": 2,
            "fontSize": 11,
            "color": "#6E675C"
          },
          "encoding": {
            "text": {
              "field": "value_label",
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.show_label == 'True' && datum.label_side == 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -18,
            "dy": -12,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#23211E"
          },
          "encoding": {
            "text": {
              "field": "country",
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.show_label == 'True' && datum.label_side == 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -18,
            "dy": 2,
            "fontSize": 11,
            "color": "#6E675C"
          },
          "encoding": {
            "text": {
              "field": "value_label",
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_side == 'above'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "dy": -36,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#23211E"
          },
          "encoding": {
            "text": {
              "field": "country",
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_side == 'above'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "dy": -22,
            "fontSize": 11,
            "color": "#6E675C"
          },
          "encoding": {
            "text": {
              "field": "value_label",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "longitude": 124,
            "latitude": -29,
            "label": "Australia"
          }
        ]
      },
      "mark": {
        "type": "text",
        "color": "white",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#FAF6EE",
    "font": "'Source Sans 3', Arial, sans-serif",
    "view": {
      "stroke": null
    }
  }
}
