{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: each commodity group's share of Australian food exports in every financial year from 1988-89 to 2024-25. Darker cells mean a bigger share.",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/commodities_by_year.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "#FAF6EE",
    "strokeWidth": 0.6
  },
  "encoding": {
    "x": {
      "field": "fy",
      "type": "ordinal",
      "title": "Financial year",
      "axis": {
        "labelAngle": 0,
        "values": [
          "1989–90",
          "1994–95",
          "1999–00",
          "2004–05",
          "2009–10",
          "2014–15",
          "2019–20",
          "2024–25"
        ],
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Beef",
        "Wheat",
        "Dairy",
        "Sugar",
        "Wine",
        "Seafood",
        "Lamb & mutton",
        "Other grains",
        "Barley",
        "Fruit & nuts",
        "Live animals",
        "Canola & oilseeds",
        "Pulses",
        "Other meat",
        "Vegetables"
      ],
      "axis": {
        "ticks": false,
        "domain": false,
        "labelPadding": 6
      }
    },
    "color": {
      "field": "share",
      "type": "quantitative",
      "title": "Share of food exports (%)",
      "scale": {
        "domain": [
          0,
          30
        ],
        "range": [
          "#FBF3E1",
          "#EBC46B",
          "#C8692F",
          "#8C3B1F",
          "#3B1A0E"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "gradientLength": 500,
        "labelExpr": "datum.label + '%'"
      }
    },
    "tooltip": [
      {
        "field": "group",
        "type": "nominal",
        "title": "Commodity"
      },
      {
        "field": "fy",
        "type": "nominal",
        "title": "Financial year"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share of food exports (%)",
        "format": ".1f"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Exports (A$m)",
        "format": "$,.0f"
      }
    ]
  },
  "config": {
    "background": "#FAF6EE",
    "font": "'Source Sans 3', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5C564C",
      "titleColor": "#3A362F",
      "gridColor": "#E8E1D3",
      "domainColor": "#BDB4A4",
      "tickColor": "#BDB4A4",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#3A362F",
      "titleColor": "#3A362F",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
